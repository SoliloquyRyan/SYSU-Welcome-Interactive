{
	email {$SYSU_WELCOME_TLS_EMAIL}
}

{$SYSU_WELCOME_DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}

	handle /ws* {
		reverse_proxy 127.0.0.1:3000 {
			stream_close_delay 5m
		}
	}

	handle {
		root * /opt/sysu-welcome/current/frontend/dist
		route {
			try_files {path} /index.html
			header /index.html Cache-Control "no-store"
			file_server
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self' data:"
		-Server
	}
}
