# 非秘密的本地 Demo 配置示例。应用不自动读取本文件。
DEMO_BACKEND_HOST=127.0.0.1
DEMO_BACKEND_PORT=3000
DEMO_DATABASE_PATH=.data/demo.sqlite
DEMO_SEED_MANIFEST_PATH=.data/demo-seed-manifest.json
DEMO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_LOG_LEVEL=info
# Optional local-only token for the OBS interaction-audio bridge. Generate a
# random value of at least 16 characters outside the repository before use.
OBS_AUDIO_BRIDGE_TOKEN=
